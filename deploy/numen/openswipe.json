      "triggerMode": "SWIPE"
    },
    {
      "id": "default_right",
      "trigger": { "edge": "RIGHT", "section": [0, 1], "gesture": "SWIPE" },
      "action": { "id": "back" },
      "enabled": true,
      "triggerMode": "SWIPE"
    },
    {
      "id": "default_bottom",
      "trigger": { "edge": "BOTTOM", "section": [0, 1], "gesture": "SWIPE" },
      "action": { "id": "home" },
      "enabled": true,
      "triggerMode": "SWIPE"
    }
  ]
}
