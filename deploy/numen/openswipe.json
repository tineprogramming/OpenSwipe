{
  "version": 1,
  "settings": {
    "edgeTriggerWidthDp": 20,
    "bottomTriggerHeightDp": 40,
    "disableBottomOnIme": true,
    "disableSidesOnIme": false
  },
  "rules": [
    {
      "id": "default_left",
      "trigger": { "edge": "LEFT", "section": [0, 1], "gesture": "SWIPE" },
      "action": { "id": "back" },
